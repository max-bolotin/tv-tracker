# Example env file for docker-compose (copy to .env and fill values)

# Upload limits
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=50MB
MAX_SWALLOW_SIZE=52428800

# External API keys
TMDB_API_KEY=

# Google OAuth credentials (for production/deploy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend URL used by the backend when redirecting after OAuth
FRONTEND_URL=http://localhost:5173
